{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PairDock",
  "version": "../package.json",
  "identifier": "dev.pairdock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PairDock",
        "width": 920,
        "height": 612,
        "minWidth": 750,
        "minHeight": 510,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Pair and configure Logitech receivers without Logi Options+",
    "publisher": "PairDock contributors",
    "homepage": "https://github.com/n2ns/pairdock",
    "copyright": "Copyright (c) 2026 PairDock contributors",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyRDdGMkEyMDVFMTYyRjUKUldUMVl1RUZvdkxYOGxyRVdHemNWY2xZS2hQWFBqMW1jaTVQYS9NNys3TWIvUkl6UXRLOW1BYlEK",
      "endpoints": [
        "https://github.com/n2ns/pairdock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
